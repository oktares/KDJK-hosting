# =========================================================================
# DOMAIN & SSL CONFIGURATION
# =========================================================================
# Subdomain dan domain utama Anda (Contoh: n8n.perusahaan.com)
SUBDOMAIN=n8n
DOMAIN_NAME=domainanda.com

# Email valid untuk notifikasi masa aktif & registrasi SSL Let's Encrypt
SSL_EMAIL=admin@domainanda.com

# Zona Waktu Server (WIB: Asia/Jakarta, WITA: Asia/Makassar, WIT: Asia/Jayapura)
GENERIC_TIMEZONE=Asia/Jakarta

# =========================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =========================================================================
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=GantiDenganPasswordDatabaseSangatKuat2026!
POSTGRES_DB=n8n_production

# =========================================================================
# N8N ENCRYPTION & SECURITY KEY
# =========================================================================
# Generate key dengan perintah: openssl rand -hex 24
# PENTING: Simpan key ini baik-baik! Jangan hilang saat migrasi/backup!
N8N_ENCRYPTION_KEY=d7a9b1c3e5f7a2b4c6d8e0f1a3b5c7d9e2f4a6b8c0d2e4f6

# =========================================================================
# PERFORMANCE & STORAGE SETTINGS
# =========================================================================
# Batas maksimal ukuran file payload yang diunggah/diolah (dalam MB)
N8N_PAYLOAD_SIZE_MAX=128

# Pembersihan otomatis histori eksekusi untuk menghemat kapasitas disk
EXECUTIONS_DATA_PRUNE=true
# Hapus eksekusi yang lebih lama dari X jam (168 jam = 7 hari)
EXECUTIONS_DATA_MAX_AGE=168
# Maksimal jumlah histori eksekusi yang disimpan
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# =========================================================================
# LOGGING & DEBUGGING
# =========================================================================
# Level log: error, warn, info, verbose, debug
N8N_LOG_LEVEL=info
# Matikan telemetri jika ingin privasi total
N8N_DIAGNOSTICS_ENABLED=false

# =========================================================================
# AI & TELEGRAM BOT CONFIGURATION (KDJK Project)
# =========================================================================
# Google Gemini API Key untuk parsing pesan transaksi keuangan
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_SAMPLE

